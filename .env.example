# Base URL of zenko-api
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Email authentication and recovery endpoints exposed by zenko-api.
NUXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=true
NUXT_PUBLIC_PASSWORD_RESET_ENABLED=true
NUXT_PUBLIC_PASSWORD_CHANGE_ENABLED=true

# Whether checkout may call POST /orders. Off until zenko-api (Postgres) and a
# payment gateway are wired up; while off, checkout says payment is not
# connected instead of placing an order.
NUXT_PUBLIC_PAYMENT_ENABLED=false

# Dev-only: with PAYMENT_ENABLED on, settle a fresh order via zenko-api's stub
# pay endpoint so the package is owned immediately. Needs the backend's own
# stub enabled. Never in production.
NUXT_PUBLIC_PAYMENT_STUB=false
