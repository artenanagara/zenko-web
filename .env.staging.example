# Template for /etc/zenko/web-staging.env on the VPS. Copy it there and fill
# in the blanks — see zenko-web-staging.service.

# Nitro's node-server reads PORT/HOST directly; no Nuxt config change needed.
PORT=3001
HOST=127.0.0.1

# Routed through the staging Nginx block to zenko-api-staging (port 8081),
# never the production API.
NUXT_PUBLIC_API_BASE=https://staging.zenkoedu.id/api/v1

NUXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=true
NUXT_PUBLIC_PASSWORD_RESET_ENABLED=true
NUXT_PUBLIC_PASSWORD_CHANGE_ENABLED=true

# On, so checkout actually calls POST /orders against the sandbox-configured
# zenko-api-staging and exercises the real Midtrans QRIS flow.
NUXT_PUBLIC_PAYMENT_ENABLED=true
NUXT_PUBLIC_PAYMENT_STUB=false

# Staging-only rollout: tutors may edit question content on live products.
# The matching API flag is TUTOR_LIVE_CONTENT_EDIT_ENABLED=true.
NUXT_PUBLIC_TUTOR_LIVE_CONTENT_EDIT_ENABLED=true
