server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name zenkoedu.id www.zenkoedu.id 103.89.5.73 _;

    # IP-address certificates are short lived, so Certbot must be able to
    # renew through HTTP without taking Nginx or the application offline.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 308 https://zenkoedu.id$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name 103.89.5.73 _;

    ssl_certificate /etc/letsencrypt/live/103.89.5.73/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/103.89.5.73/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://zenkoedu.id$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name www.zenkoedu.id;

    ssl_certificate /etc/letsencrypt/live/zenkoedu.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zenkoedu.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://zenkoedu.id$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name zenkoedu.id;
    client_max_body_size 2m;

    ssl_certificate /etc/letsencrypt/live/zenkoedu.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zenkoedu.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- Mode perbaikan -------------------------------------------------
    # Dinyalakan dengan membuat berkas penanda (lihat deploy/maintenance-mode.sh),
    # bukan dengan menyunting berkas ini — supaya menyalakan dan mematikannya
    # tidak pernah butuh reload Nginx dan tidak bisa salah ketik saat panik.
    #
    # `if` di level server memang cuma dievaluasi sekali per permintaan dan
    # aman untuk `return` — inilah satu dari sedikit pemakaian `if` yang tidak
    # termasuk "if is evil" di dokumentasi Nginx.
    set $maintenance 0;
    if (-f /var/www/zenko-maintenance/on) {
        set $maintenance 1;
    }

    # 503 + Retry-After, bukan 200: mesin pencari harus tahu ini keadaan
    # sementara. Membalas 200 dengan isi halaman perbaikan mengundang
    # de-indexing halaman katalog yang sebenarnya baik-baik saja.
    error_page 503 @maintenance;
    location @maintenance {
        root /var/www/zenko-maintenance;
        add_header Retry-After 600 always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://zenkoedu.id; frame-src 'none'; upgrade-insecure-requests" always;
        try_files /index.html =503;
    }

    # Upstream mati saat deploy juga memunculkan halaman ini, bukan layar 502
    # telanjang dari Nginx. Deploy sudah punya health check dan rollback, jadi
    # jendelanya pendek — tapi kalau sampai terlihat pengunjung, yang mereka
    # lihat halaman Zenko, bukan pesan galat server.
    error_page 502 504 @maintenance;

    location = /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        # Klien API mengurai JSON. Mengirimi mereka HTML halaman perbaikan
        # membuat fetch di sisi web gagal dengan galat parse yang membingungkan,
        # bukan dengan status yang bisa ditindaklanjuti — jadi jalur ini punya
        # balasan JSON-nya sendiri. `default_type` harus mendahului `return`:
        # ia yang menentukan Content-Type balasan yang DIBUAT Nginx. Untuk
        # respons yang diproksi, header dari upstream tetap yang menang.
        default_type application/json;
        if ($maintenance = 1) {
            return 503 '{"error":"Zenko sedang dalam perbaikan. Coba lagi beberapa saat lagi.","maintenance":true}';
        }

        # A question/thumbnail image upload is capped at 5 MB by the API
        # (handler.maxImageUploadBytes); the extra megabyte covers multipart
        # overhead and stays under the Fiber BodyLimit of 8 MB. Without this the
        # server-level 2m limit rejects the upload with a bare 413.
        client_max_body_size 6m;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Uploaded images live on the API's local disk (UPLOAD_DIR in
    # zenko-api.service) and are served back by its /uploads static route. They
    # are proxied to the API rather than read straight off disk so Nginx needs
    # no access to the unit's state directory. Without this block /uploads/...
    # falls through to location / and Nuxt answers 404 for every image.
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Brand assets are versioned in the web bundle and safe to cache for a
    # year; this avoids paying the image request cost on every page view.
    location ^~ /brand/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        if ($maintenance = 1) {
            return 503;
        }

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
# Nuxt Nitro emits the CSP with a per-response nonce for SSR scripts.
}

# --- Marketing production -------------------------------------------------
# This host shares the production process, while the app's global host guard
# exposes only the Marketing Hub routes here.
server {
    listen 80;
    listen [::]:80;
    server_name marketing.zenkoedu.id;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type "text/plain"; try_files $uri =404; }
    location / { return 308 https://marketing.zenkoedu.id$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name marketing.zenkoedu.id;
    client_max_body_size 6m;
    ssl_certificate /etc/letsencrypt/live/marketing.zenkoedu.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/marketing.zenkoedu.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location ^~ /api/ { proxy_pass http://127.0.0.1:8080; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 60s; }
    location ^~ /uploads/ { proxy_pass http://127.0.0.1:8080; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_hide_header Cache-Control; add_header Cache-Control "public, max-age=31536000, immutable" always; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_read_timeout 60s; }
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}

# --- Admin production ------------------------------------------------------
# Same process as the host above; the app's workspace guard
# (app/utils/workspace.ts) exposes only /dashboard/admin and the login
# routes here. Get the cert once with:
#   certbot certonly --nginx -d admin.zenkoedu.id
# after admin.zenkoedu.id's DNS A/AAAA record points at this host, and add
# https://admin.zenkoedu.id to ALLOW_ORIGINS in the matching zenko-api env file.
server {
    listen 80;
    listen [::]:80;
    server_name admin.zenkoedu.id;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type "text/plain"; try_files $uri =404; }
    location / { return 308 https://admin.zenkoedu.id$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.zenkoedu.id;
    client_max_body_size 6m;
    ssl_certificate /etc/letsencrypt/live/admin.zenkoedu.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.zenkoedu.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location ^~ /api/ { proxy_pass http://127.0.0.1:8080; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 60s; }
    location ^~ /uploads/ { proxy_pass http://127.0.0.1:8080; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_hide_header Cache-Control; add_header Cache-Control "public, max-age=31536000, immutable" always; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_read_timeout 60s; }
    # An admin console is never something to index, on any environment.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}

# --- Staging (reuses this VPS: zenko-api-staging on 8081, zenko-web-staging
# on 3001 — see deploy/zenko-api-staging.service and
# deploy/zenko-web-staging.service). Get the cert once with:
#   certbot certonly --nginx -d staging.zenkoedu.id
# after staging.zenkoedu.id's DNS A/AAAA record points at this host.

server {
    listen 80;
    listen [::]:80;

    server_name staging.zenkoedu.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        # Staging is intentionally public so remote testers can reach the
        # application.
        return 308 https://staging.zenkoedu.id$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name staging.zenkoedu.id;
    client_max_body_size 2m;

    ssl_certificate /etc/letsencrypt/live/staging.zenkoedu.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.zenkoedu.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location = /health {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        # A question/thumbnail image upload is capped at 5 MB by the API
        # (handler.maxImageUploadBytes); the extra megabyte covers multipart
        # overhead and stays under the Fiber BodyLimit of 8 MB. Without this the
        # server-level 2m limit rejects the upload with a bare 413.
        client_max_body_size 6m;

        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Uploaded images live on the API's local disk (UPLOAD_DIR in
    # zenko-api.service) and are served back by its /uploads static route. They
    # are proxied to the API rather than read straight off disk so Nginx needs
    # no access to the unit's state directory. Without this block /uploads/...
    # falls through to location / and Nuxt answers 404 for every image.
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /brand/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }

    # Staging is a testing surface, not a public product page — keep it out
    # of search results regardless of what the app's own robots.txt says.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
# Nuxt Nitro emits the CSP with a per-response nonce for SSR scripts.
}

